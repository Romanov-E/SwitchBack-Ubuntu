    # --------------------------------------------------------------------------
    # Actions & Installation Workflow
    # --------------------------------------------------------------------------
    def log(self, text):
        def _append():
            timestamp = time.strftime("[%H:%M:%S]")
            line = f"{timestamp} {text}\n"
            self.log_lines.append(line)
            end_iter = self.log_buffer.get_end_iter()
            self.log_buffer.insert(end_iter, line)
            # Auto scroll to bottom
            mark = self.log_buffer.create_mark(None, self.log_buffer.get_end_iter(), False)
            self.log_view.scroll_to_mark(mark, 0.05, False, 0.0, 1.0)
        GLib.idle_add(_append)

    def on_copy_log(self, btn):
        clipboard = self.win.get_clipboard()
        clipboard.set("".join(self.log_lines))
        toast = Adw.Toast.new(self.t('log_copied'))
        self.toast_overlay.add_toast(toast)

    def on_open_preferences(self, btn):
        try:
            subprocess.Popen(['gnome-extensions', 'prefs', 'switchback@local'])
        except Exception as e:
            self.log(f"Failed to open preferences: {e}")

    def on_start_install(self, btn):
        self.stack.set_visible_child_name("progress")
        self.progress_bar.set_fraction(0.0)
        self.log_lines.clear()
        self.log_buffer.set_text("")
        self.need_logout = False

        for row in self.step_rows.values():
            row.set_status("pending")

        options = {
            'caps_toggle': self.row_caps.get_active(),
            'enable_daemon': self.row_daemon.get_active(),
            'open_prefs': self.row_prefs.get_active()
        }

        thread = threading.Thread(target=self.run_installation, args=(options,), daemon=True)
        thread.start()

    def run_installation(self, options):
        self.is_installing = True
        self.log("🚀 Starting SwitchBack Ubuntu installation...")
        self.log(f"Source directory: {PROJECT_DIR}")

        try:
            # Step 1: Dependencies
            GLib.idle_add(self.step_rows['deps'].set_status, "running")
            GLib.idle_add(self.progress_bar.set_fraction, 0.15)
            self.log("Checking system dependencies (python3, glib-compile-schemas, gnome-extensions)...")

            missing = []
            for cmd in ['python3', 'glib-compile-schemas', 'gnome-extensions']:
                if not shutil.which(cmd):
                    missing.append(cmd)

            if missing:
                self.log(f"Missing packages: {', '.join(missing)}. Requesting installation via pkexec apt-get...")
                res = subprocess.run(
                    ['pkexec', 'apt-get', 'install', '-y', 'python3', 'libglib2.0-bin', 'gnome-shell'],
                    capture_output=True, text=True
                )
                if res.returncode != 0:
                    raise RuntimeError(f"Failed to install dependencies: {res.stderr}")
                self.log("Dependencies installed successfully.")
            else:
                self.log("All dependencies are satisfied.")
            GLib.idle_add(self.step_rows['deps'].set_status, "done")

            # Step 2: Input group
            GLib.idle_add(self.step_rows['input'].set_status, "running")
            GLib.idle_add(self.progress_bar.set_fraction, 0.30)
            user = os.environ.get('USER')
            if not user:
                try:
                    user = os.getlogin()
                except Exception:
                    pass
            if not user:
                try:
                    import pwd
                    user = pwd.getpwuid(os.getuid()).pw_name
                except Exception:
                    user = 'user'
            self.log(f"Checking hardware keyboard permissions for user '{user}' in /dev/input...")

            try:
                groups_out = subprocess.check_output(['groups', user], text=True)
                in_input = 'input' in groups_out.split()
            except Exception:
                in_input = False

            if not in_input:
                self.log(f"User '{user}' is not in 'input' group. Requesting elevated privileges via pkexec...")
                res = subprocess.run(['pkexec', 'usermod', '-aG', 'input', user], capture_output=True, text=True)
                if res.returncode != 0:
                    raise RuntimeError(f"Failed to add user to 'input' group: {res.stderr}")
                self.need_logout = True
                self.log(f"✅ User '{user}' added to 'input' group (session logout required).")
            else:
                self.log("✅ User already has 'input' group access.")
            GLib.idle_add(self.step_rows['input'].set_status, "done")

            # Step 3: Compile Schemas & Locales
            GLib.idle_add(self.step_rows['schemas'].set_status, "running")
            GLib.idle_add(self.progress_bar.set_fraction, 0.50)
            self.log("Compiling extension GSettings schemas and locale translations...")

            schemas_dir = os.path.join(PROJECT_DIR, "extension", "schemas")
            subprocess.run(['glib-compile-schemas', schemas_dir], check=True)

            user_glib = os.path.expanduser("~/.local/share/glib-2.0/schemas")
            os.makedirs(user_glib, exist_ok=True)
            schema_file = "org.gnome.shell.extensions.switchback.gschema.xml"
            shutil.copyfile(
                os.path.join(schemas_dir, schema_file),
                os.path.join(user_glib, schema_file)
            )
            subprocess.run(['glib-compile-schemas', user_glib], check=True)

            locales_script = os.path.join(PROJECT_DIR, "scripts", "compile_locales.py")
            if os.path.exists(locales_script):
                subprocess.run([sys.executable, locales_script], check=True)
                self.log("Compiled locale catalogs (.mo).")

            GLib.idle_add(self.step_rows['schemas'].set_status, "done")

            # Step 4: Deploy Extension
            GLib.idle_add(self.step_rows['ext'].set_status, "running")
            GLib.idle_add(self.progress_bar.set_fraction, 0.65)
            ext_target = os.path.expanduser("~/.local/share/gnome-shell/extensions/switchback@local")
            self.log(f"Deploying extension files to {ext_target}...")

            os.makedirs(os.path.join(ext_target, "schemas"), exist_ok=True)
            os.makedirs(os.path.join(ext_target, "locale"), exist_ok=True)
            os.makedirs(os.path.join(ext_target, "icons"), exist_ok=True)

            for item in ["metadata.json", "extension.js", "prefs.js"]:
                src = os.path.join(PROJECT_DIR, "extension", item)
                if os.path.exists(src):
                    shutil.copy2(src, ext_target)

            for f in os.listdir(schemas_dir):
                shutil.copy2(os.path.join(schemas_dir, f), os.path.join(ext_target, "schemas"))

            loc_src = os.path.join(PROJECT_DIR, "extension", "locale")
            if os.path.exists(loc_src):
                shutil.copytree(loc_src, os.path.join(ext_target, "locale"), dirs_exist_ok=True)

            svg_icon = os.path.join(PROJECT_DIR, "desktop", "icons", "switchback.svg")
            if os.path.exists(svg_icon):
                shutil.copy2(svg_icon, os.path.join(ext_target, "icons"))

            GLib.idle_add(self.step_rows['ext'].set_status, "done")

            # Step 5: Deploy Daemon & Systemd Service
            GLib.idle_add(self.step_rows['daemon'].set_status, "running")
            GLib.idle_add(self.progress_bar.set_fraction, 0.80)

            daemon_target = os.path.expanduser("~/.local/share/switchback")
            os.makedirs(daemon_target, exist_ok=True)
            daemon_py = os.path.join(daemon_target, "daemon.py")
            shutil.copy2(os.path.join(PROJECT_DIR, "daemon", "daemon.py"), daemon_py)
            os.chmod(daemon_py, 0o755)

            # Remove legacy settings files if present
            legacy_desktop = os.path.expanduser("~/.local/share/applications/switchback-settings.desktop")
            legacy_bin = os.path.expanduser("~/.local/bin/switchback-settings")
            legacy_py = os.path.join(daemon_target, "switchback-settings.py")
            for leg in [legacy_desktop, legacy_bin, legacy_py]:
                if os.path.exists(leg):
                    try:
                        os.remove(leg)
                    except Exception:
                        pass
            if shutil.which("update-desktop-database"):
                subprocess.run(["update-desktop-database", os.path.expanduser("~/.local/share/applications")], capture_output=True, check=False)

            # Icon
            icon_dir = os.path.expanduser("~/.local/share/icons/hicolor/scalable/apps")
            os.makedirs(icon_dir, exist_ok=True)
            shutil.copy2(svg_icon, os.path.join(icon_dir, "switchback.svg"))
            if shutil.which("gtk-update-icon-cache"):
                subprocess.run(["gtk-update-icon-cache", "-q", os.path.expanduser("~/.local/share/icons/hicolor")], check=False)

            # Service
            service_dir = os.path.expanduser("~/.config/systemd/user")
            os.makedirs(service_dir, exist_ok=True)
            shutil.copy2(
                os.path.join(PROJECT_DIR, "daemon", "switchback-daemon.service"),
                service_dir
            )

            subprocess.run(["systemctl", "--user", "daemon-reload"], check=True)
            if options.get('enable_daemon', True):
                subprocess.run(["systemctl", "--user", "enable", "switchback-daemon.service"], check=False)
                subprocess.run(["systemctl", "--user", "restart", "switchback-daemon.service"], check=False)
                self.log("✅ Background daemon service activated.")

            GLib.idle_add(self.step_rows['daemon'].set_status, "done")

            # Step 6: Caps Lock & Enable Extension
            GLib.idle_add(self.step_rows['enable'].set_status, "running")
            GLib.idle_add(self.progress_bar.set_fraction, 0.95)

            if options.get('caps_toggle', True):
                try:
                    cur_xkb = subprocess.check_output(
                        ['gsettings', 'get', 'org.gnome.desktop.input-sources', 'xkb-options'],
                        text=True
                    )
                    if 'grp:caps_toggle' not in cur_xkb:
                        subprocess.run([
                            'gsettings', 'set', 'org.gnome.desktop.input-sources', 'xkb-options', "['grp:caps_toggle']"
                        ], check=False)
                        self.log("✅ Configured Caps Lock layout switching.")
                except Exception as e:
                    self.log(f"Notice: Failed to set xkb-options: {e}")

            subprocess.run(['gnome-extensions', 'enable', 'switchback@local'], check=False)
            self.log("✅ GNOME Shell extension enabled.")
            GLib.idle_add(self.step_rows['enable'].set_status, "done")
            GLib.idle_add(self.progress_bar.set_fraction, 1.0)

            # Finish
            time.sleep(0.4)
            GLib.idle_add(self.show_done_page, options)

        except Exception as e:
            self.log(f"❌ Error during installation: {e}")
            GLib.idle_add(self.show_error_page, str(e))
        finally:
            self.is_installing = False

    def show_done_page(self, options):
        # Configure notice card
        child = self.done_notice_box.get_first_child()
        self.done_notice_box.remove_css_class("status-box-warn")
        self.done_notice_box.remove_css_class("status-box-success")

        if self.need_logout:
            self.done_notice_box.add_css_class("status-box-warn")
            self.done_notice_title.set_text(self.t('logout_warn_title'))
            self.done_notice_desc.set_text(self.t('logout_warn_desc'))
        else:
            self.done_notice_box.add_css_class("status-box-success")
            self.done_notice_title.set_text(self.t('all_ready_title'))
            self.done_notice_desc.set_text(self.t('all_ready_desc'))

        self.stack.set_visible_child_name("done")

        if options.get('open_prefs', True) and not self.need_logout:
            def _open_prefs():
                try:
                    subprocess.Popen(['gnome-extensions', 'prefs', 'switchback@local'])
                except Exception:
                    pass
                return GLib.SOURCE_REMOVE
            GLib.timeout_add(600, _open_prefs)

    def show_error_page(self, error_msg):
        self.error_desc.set_text(error_msg)
        self.stack.set_visible_child_name("error")

