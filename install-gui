    def check_existing_installation(self):
        ext_path = os.path.expanduser('~/.local/share/gnome-shell/extensions/switchback@local/metadata.json')
        if os.path.exists(ext_path):
            self.installed_version = VERSION
        else:
            self.installed_version = None

        try:
            res = subprocess.run(
                ['systemctl', '--user', 'is-active', 'switchback-daemon.service'],
                capture_output=True, text=True, timeout=2
            )
            self.daemon_active = (res.stdout.strip() == 'active')
        except Exception:
            self.daemon_active = False

