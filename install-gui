class StepRow(Gtk.Box):
    def __init__(self, title_text, desc_text):
        super().__init__(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
        self.set_margin_top(4)
        self.set_margin_bottom(4)
        self.add_css_class("step-row")

        # Icon stack: pending / spinner / done / error
        self.icon_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.icon_box.set_valign(Gtk.Align.CENTER)
        self.icon_box.set_size_request(24, 24)

        self.pending_icon = Gtk.Image.new_from_icon_name("radio-symbolic")
        self.pending_icon.add_css_class("dim-label")

        self.spinner = Gtk.Spinner()
        self.spinner.set_size_request(20, 20)

        self.done_icon = Gtk.Image.new_from_icon_name("emblem-ok-symbolic")
        self.done_icon.add_css_class("accent-success")

        self.error_icon = Gtk.Image.new_from_icon_name("dialog-error-symbolic")
        self.error_icon.add_css_class("accent-error")

        self.icon_box.append(self.pending_icon)
        self.append(self.icon_box)

        # Text box
        text_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        text_box.set_hexpand(True)

        self.title_label = Gtk.Label(label=title_text, xalign=0)
        self.title_label.add_css_class("heading-step")

        self.desc_label = Gtk.Label(label=desc_text, xalign=0)
        self.desc_label.add_css_class("caption")
        self.desc_label.add_css_class("dim-label")

        text_box.append(self.title_label)
        text_box.append(self.desc_label)
        self.append(text_box)

        self.set_status("pending")

    def set_status(self, status):
        # Remove current child
        child = self.icon_box.get_first_child()
        if child:
            self.icon_box.remove(child)

        self.remove_css_class("step-pending")
        self.remove_css_class("step-running")
        self.remove_css_class("step-done")
        self.remove_css_class("step-error")

        if status == "pending":
            self.icon_box.append(self.pending_icon)
            self.add_css_class("step-pending")
        elif status == "running":
            self.icon_box.append(self.spinner)
            self.spinner.start()
            self.add_css_class("step-running")
        elif status == "done":
            self.spinner.stop()
            self.icon_box.append(self.done_icon)
            self.add_css_class("step-done")
        elif status == "error":
            self.spinner.stop()
            self.icon_box.append(self.error_icon)
            self.add_css_class("step-error")

    def update_texts(self, title_text, desc_text):
        self.title_label.set_text(title_text)
        self.desc_label.set_text(desc_text)


class SwitchBackInstaller(Adw.Application):
    def __init__(self):
        super().__init__(
            application_id="io.github.romanov_e.switchback.installer",
            flags=Gio.ApplicationFlags.NON_UNIQUE
        )
        # Default language based on system locale
        lang = os.environ.get('LANG', 'en').lower()
        self.current_lang = 'ru' if lang.startswith('ru') else 'en'
        self.need_logout = False
        self.log_lines = []
        self.installed_version = None
        self.daemon_active = False
        self.is_installing = False

    def t(self, key, **kwargs):
        text = TRANSLATIONS[self.current_lang].get(key, key)
        if kwargs:
            return text.format(**kwargs)
        return text

    def on_close_request(self, window):
        if self.is_installing:
            toast = Adw.Toast.new(self.t('install_in_progress'))
            self.toast_overlay.add_toast(toast)
            return True
        return False

    def do_activate(self):
        self.check_existing_installation()

        self.win = Adw.ApplicationWindow(application=self, title=self.t('app_title'))
        self.win.set_default_size(620, 840)
        self.win.set_size_request(480, 560)
        self.win.connect("close-request", self.on_close_request)

        # Custom CSS styling
        self.load_styles()

        # Toast overlay
        self.toast_overlay = Adw.ToastOverlay()
        self.win.set_content(self.toast_overlay)

        # Main Box
        main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.toast_overlay.set_child(main_box)

        # HeaderBar
        self.header_bar = Adw.HeaderBar()
        self.title_widget = Adw.WindowTitle(
            title=self.t('app_title'),
            subtitle=self.t('version')
        )
        self.header_bar.set_title_widget(self.title_widget)

        # Language toggle button
        self.lang_btn = Gtk.Button(label=self.t('lang_toggle'))
        self.lang_btn.add_css_class("flat")
        self.lang_btn.connect("clicked", self.on_toggle_language)
        self.header_bar.pack_start(self.lang_btn)

        main_box.append(self.header_bar)

        # View Stack for Pages
        self.stack = Adw.ViewStack()
        main_box.append(self.stack)

        # Build Pages
        self.build_welcome_page()
        self.build_progress_page()
        self.build_done_page()
        self.build_uninstalled_page()
        self.build_error_page()

        self.stack.set_visible_child_name("welcome")
        self.win.present()

