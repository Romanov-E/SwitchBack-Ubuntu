            dialog = Adw.AlertDialog(
                heading=self.t('uninstall_confirm_title'),
                body=self.t('uninstall_confirm_desc')
            )
            dialog.add_response("cancel", self.t('btn_cancel'))
            dialog.add_response("uninstall", self.t('btn_uninstall_action'))
            dialog.set_response_appearance("uninstall", Adw.ResponseAppearance.DESTRUCTIVE)
            dialog.connect("response", self.on_uninstall_response)
            dialog.present(self.win)
        else:
            dialog = Adw.MessageDialog(
                transient_for=self.win,
                heading=self.t('uninstall_confirm_title'),
                body=self.t('uninstall_confirm_desc')
            )
            dialog.add_response("cancel", self.t('btn_cancel'))
            dialog.add_response("uninstall", self.t('btn_uninstall_action'))
            dialog.set_response_appearance("uninstall", Adw.ResponseAppearance.DESTRUCTIVE)
            dialog.connect("response", self.on_uninstall_response)
            dialog.present()

    def on_uninstall_response(self, dialog, response):
        if response == "uninstall":
            self.stack.set_visible_child_name("progress")
            self.progress_title.set_text(self.t('uninstalling_title'))
            self.progress_bar.set_fraction(0.3)
            self.log_lines.clear()
            self.log_buffer.set_text("")

            for row in self.step_rows.values():
                row.set_status("pending")

            thread = threading.Thread(target=self.run_uninstallation, daemon=True)
            thread.start()

    def run_uninstallation(self):
        self.is_installing = True
        self.log("🧹 Starting SwitchBack uninstallation...")
        try:
            # 1. Disable & remove extension
            self.log("Disabling GNOME extension...")
            subprocess.run(['gnome-extensions', 'disable', 'switchback@local'], check=False)
            ext_path = os.path.expanduser("~/.local/share/gnome-shell/extensions/switchback@local")
            if os.path.exists(ext_path):
                shutil.rmtree(ext_path, ignore_errors=True)
            self.log("Extension files removed.")
            GLib.idle_add(self.progress_bar.set_fraction, 0.4)

            # 2. Stop & disable daemon service
            self.log("Stopping and disabling switchback-daemon.service...")
            subprocess.run(['systemctl', '--user', 'stop', 'switchback-daemon.service'], check=False)
            subprocess.run(['systemctl', '--user', 'disable', 'switchback-daemon.service'], check=False)
            svc_file = os.path.expanduser("~/.config/systemd/user/switchback-daemon.service")
            if os.path.exists(svc_file):
                os.remove(svc_file)
            subprocess.run(['systemctl', '--user', 'daemon-reload'], check=False)
            self.log("Daemon service removed.")
            GLib.idle_add(self.progress_bar.set_fraction, 0.6)

            # 3. Remove daemon folder & shm
            daemon_folder = os.path.expanduser("~/.local/share/switchback")
            if os.path.exists(daemon_folder):
                shutil.rmtree(daemon_folder, ignore_errors=True)
            shm_file = "/dev/shm/switchback_key"
            if os.path.exists(shm_file):
                try:
                    os.remove(shm_file)
                except Exception:
                    pass
            GLib.idle_add(self.progress_bar.set_fraction, 0.8)

            # 4. Remove schema & icon
            schema_file = os.path.expanduser("~/.local/share/glib-2.0/schemas/org.gnome.shell.extensions.switchback.gschema.xml")
            if os.path.exists(schema_file):
                os.remove(schema_file)
                user_glib = os.path.expanduser("~/.local/share/glib-2.0/schemas")
                subprocess.run(['glib-compile-schemas', user_glib], check=False)

            icon_file = os.path.expanduser("~/.local/share/icons/hicolor/scalable/apps/switchback.svg")
            if os.path.exists(icon_file):
                os.remove(icon_file)
                if shutil.which("gtk-update-icon-cache"):
                    subprocess.run(["gtk-update-icon-cache", "-q", os.path.expanduser("~/.local/share/icons/hicolor")], check=False)

            self.log("✅ SwitchBack has been cleanly uninstalled.")
            GLib.idle_add(self.progress_bar.set_fraction, 1.0)
            time.sleep(0.4)
            GLib.idle_add(self.stack.set_visible_child_name, "uninstalled")

        except Exception as e:
            self.log(f"Error during uninstall: {e}")
            GLib.idle_add(self.show_error_page, str(e))
        finally:
            self.is_installing = False


def main():
    app = SwitchBackInstaller()
    return app.run(sys.argv)

if __name__ == "__main__":
    sys.exit(main())
