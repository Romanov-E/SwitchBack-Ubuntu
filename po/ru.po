# ══════════════════════════════════════════════════════════════
# СТРАНИЦА 1: ПОВЕДЕНИЕ (BEHAVIOR)
# ══════════════════════════════════════════════════════════════

msgid "Behavior"
msgstr "Поведение"

msgid "Keyboard Layout Switching"
msgstr "Переключение раскладки"

msgid "Assign Caps Lock key for quick input language switching"
msgstr "Назначение клавиши Caps Lock для быстрой смены языка ввода"

msgid "Switch layout with Caps Lock key"
msgstr "Переключение раскладки по клавише Caps Lock"

msgid "Use single press of Caps Lock to quickly switch language. When disabled, standard system shortcuts apply (Super+Space, Alt+Shift, etc.)"
msgstr "Использовать одиночное нажатие Caps Lock для быстрой смены языка. Если выключено — работают стандартные горячие клавиши системы (Super+Пробел, Alt+Shift и т.д.)"

msgid "Lock layout by holding Caps Lock"
msgstr "Фиксация раскладки удержанием Caps Lock"

msgid "Hold Caps Lock to temporarily lock current layout and disable auto-return. Single tap unlocks."
msgstr "Удерживайте Caps Lock для фиксации раскладки без автовозврата. Одиночное нажатие снимает фиксацию."

msgid "Hold duration to lock (ms)"
msgstr "Время удержания для фиксации (мс)"

msgid "Duration to hold Caps Lock before locking the layout"
msgstr "Длительность удержания Caps Lock для включения фиксации"

msgid "Layout Locked"
msgstr "Раскладка зафиксирована"

msgid "Layout Unlocked"
msgstr "Фиксация снята"

msgid "Automatic Layout Return"
msgstr "Автоматический возврат раскладки"

msgid "Return to primary language after typing inactivity and indicator bar display"
msgstr "Возврат на приоритетный язык при паузе в наборе и отображение индикатора"

msgid "Auto-return to primary layout"
msgstr "Автоматический возврат раскладки"

msgid "Switch back to primary language after typing pause (master switch)"
msgstr "Возвращать язык на приоритетный после паузы в наборе текста (главный переключатель)"

msgid "Show on-screen indicator"
msgstr "Отображать экранный индикатор"

msgid "Visual animated bar (when disabled, auto-switch works silently in background)"
msgstr "Визуальная анимированная полоса (если выключено — автовозврат работает тихо в фоне)"

msgid "Timer &amp; Switch Parameters"
msgstr "Таймер и параметры переключения"

msgid "Inactivity pause and target layout selection"
msgstr "Пауза бездействия и выбор целевой раскладки"

msgid "Timeout (seconds)"
msgstr "Время ожидания (секунды)"

msgid "Delay of typing inactivity before switching back to primary layout"
msgstr "Пауза в наборе текста, после которой раскладка переключится на приоритетную"

msgid "Target layout index"
msgstr "Индекс приоритетной раскладки"

msgid "0 — first language in GNOME input list (usually English)"
msgstr "0 — первый язык в списке ввода GNOME (обычно английский)"

msgid "Only on primary monitor"
msgstr "Только на основном мониторе"

msgid "Show countdown bar exclusively on the main display"
msgstr "Отображать индикатор исключительно на главном дисплее"

# ══════════════════════════════════════════════════════════════
# СТРАНИЦА 2: ВНЕШНИЙ ВИД (APPEARANCE)
# ══════════════════════════════════════════════════════════════

msgid "Appearance"
msgstr "Внешний вид"

msgid "Indicator Position"
msgstr "Положение индикатора"

msgid "Screen edge and display mode (single or paired)"
msgstr "Кромка экрана и режим отображения (одиночный или парный)"

msgid "Determines bar orientation and screen edges"
msgstr "Определяет ориентацию и кромки экрана"

msgid "Top of screen (horizontal)"
msgstr "Сверху экрана (горизонтально)"

msgid "Bottom of screen (horizontal)"
msgstr "Снизу экрана (горизонтально)"

msgid "Top + Bottom (two horizontal bars)"
msgstr "Сверху + Снизу (две горизонтальные полосы)"

msgid "Left of screen (vertical)"
msgstr "Слева экрана (вертикально)"

msgid "Right of screen (vertical)"
msgstr "Справа экрана (вертикально)"

msgid "Left + Right (two vertical bars)"
msgstr "Слева + Справа (две вертикальные полосы)"

msgid "Top-left corner"
msgstr "Верхний левый угол"

msgid "Top-right corner"
msgstr "Верхний правый угол"

msgid "Bottom-left corner"
msgstr "Нижний левый угол"

msgid "Bottom-right corner"
msgstr "Нижний правый угол"

msgid "All 4 corners simultaneously"
msgstr "Все 4 угла одновременно"

msgid "Screen Edge Margins"
msgstr "Отступы от краёв экрана"

msgid "Custom margins in pixels for each side of the display"
msgstr "Настройка индивидуальных зазоров в пикселях для каждой стороны дисплея"

msgid "Top margin (px)"
msgstr "Отступ сверху (px)"

msgid "Gap from the top screen edge (top panel)"
msgstr "Зазор от верхней кромки экрана (верхней панели)"

msgid "Bottom margin (px)"
msgstr "Отступ снизу (px)"

msgid "Gap from the bottom screen edge (dock)"
msgstr "Зазор от нижней кромки экрана (дока)"

msgid "Left margin (px)"
msgstr "Отступ слева (px)"

msgid "Gap from the left screen edge"
msgstr "Зазор от левой кромки экрана"

msgid "Right margin (px)"
msgstr "Отступ справа (px)"

msgid "Gap from the right screen edge"
msgstr "Зазор от правой кромки экрана"

msgid "Dimensions & Style"
msgstr "Размеры и геометрия"

msgid "Length, thickness, shape and color of the bar"
msgstr "Длина, толщина, форма и цвет полосы"

msgid "Live Preview"
msgstr "Предварительный просмотр"

msgid "Bar length (% of screen)"
msgstr "Длина полосы (% от экрана)"

msgid "Percentage of screen width (or height in vertical mode)"
msgstr "Процент от ширины (или высоты в вертикальном режиме)"

msgid "Indicator thickness"
msgstr "Толщина индикатора"

msgid "Height of horizontal bar or width of vertical bar (pixels)"
msgstr "Высота горизонтальной полосы или ширина вертикальной (в пикселях)"

msgid "Corner radius"
msgstr "Скругление углов"

msgid "Corner radius in pixels (0 — sharp corners, higher — rounded capsule)"
msgstr "Радиус скругления в пикселях (0 — острые углы, выше — скруглённая капсула)"

msgid "Indicator color"
msgstr "Цвет индикатора"

msgid "Click button to choose color or opacity"
msgstr "Нажмите кнопку для выбора цвета или прозрачности"

msgid "Choose SwitchBack bar color"
msgstr "Выберите цвет полосы SwitchBack"

msgid "Animation &amp; Transition Effects"
msgstr "Анимация и эффекты перехода"

msgid "Indicator motion style, smooth appearance and disappearance"
msgstr "Стиль движения полосы, плавное проявление и затухание"

msgid "Indicator animation style"
msgstr "Стиль анимации индикатора"

msgid "Motion of the bar during countdown"
msgstr "Движение полосы во время обратного отсчёта"

msgid "To center (symmetric from both sides)"
msgstr "К центру (симметрично с двух сторон)"

msgid "To start (left / top)"
msgstr "К началу (влево / вверх)"

msgid "To end (right / bottom)"
msgstr "К концу (вправо / вниз)"

msgid "To edges (split from center outward)"
msgstr "К краям (распадение от центра в стороны)"

msgid "Fill from center (expand to edges)"
msgstr "Заполнение от центра к краям"

msgid "From edges to center (from both sides)"
msgstr "От краёв к центру (с обоих сторон)"

msgid "Test shrink animation"
msgstr "Проверить анимацию сужения"

msgid "Click to test shrink animation"
msgstr "Нажмите для проверки анимации"

msgid "Click screen to test animation"
msgstr "Нажмите на экран для проверки анимации"

msgid "Smooth appearance and fade duration (ms)"
msgstr "Плавное появление и затухание (мс)"

msgid "Duration of fade-in and fade-out animations (0 — disabled)"
msgstr "Длительность эффектов появления и скрытия полосы (0 — выключено)"

msgid "0 ms — instant (smooth fading disabled)"
msgstr "0 мс — мгновенно (плавное затухание выключено)"

msgid "150 ms (default) — balanced smooth transition"
msgstr "150 мс (по умолчанию) — сбалансированный плавный переход"

msgid "300 ms (default) — balanced smooth transition"
msgstr "300 мс (по умолчанию) — сбалансированный плавный переход"

msgid "Separate appearance and fade timing"
msgstr "Раздельная настройка появления и затухания"

msgid "Configure different durations for fade-in and fade-out"
msgstr "Задать разное время для плавного появления и затухания"

msgid "Fade-in appearance duration (ms)"
msgstr "Время плавного появления (мс)"

msgid "Smooth appearance when switching to secondary layout"
msgstr "Плавное проявление полосы при переключении раскладки"

msgid "0 ms — instant appearance"
msgstr "0 мс — мгновенное появление"

msgid "150 ms (default) — quick crisp entrance"
msgstr "150 мс (по умолчанию) — быстрое аккуратное появление"

msgid "Smooth fade-in duration"
msgstr "Длительность плавного появления"

msgid "Fade-out dissolution duration (ms)"
msgstr "Время плавного затухания (мс)"

msgid "Smooth fade when countdown timer expires"
msgstr "Мягкое растворение полосы по завершении таймера"

msgid "0 ms — instant disappearance"
msgstr "0 мс — мгновенное исчезновение"

msgid "800 ms (default) — soft cinematic dissolution"
msgstr "800 мс (по умолчанию) — мягкое кинематографичное растворение"

msgid "Smooth fade-out duration"
msgstr "Длительность плавного затухания"

msgid "ms"
msgstr "мс"

msgid "Smooth fade-in and fade-out duration"
msgstr "Длительность плавного проявления и затухания"


# ══════════════════════════════════════════════════════════════
# СТРАНИЦА 3: СЛУЖБА (SERVICE)
# ══════════════════════════════════════════════════════════════

msgid "Service"
msgstr "Служба"

msgid "Background Service Management"
msgstr "Фоновый демон клавиатуры"

msgid "Systemd user service status and control for switchback-daemon"
msgstr "Управление системной службой switchback-daemon.service (systemd --user)"

msgid "Service Status"
msgstr "Состояние службы"

msgid "Service is active and monitoring physical keyboard via /dev/input"
msgstr "Служба активна и отслеживает клавиатуру через /dev/input"

msgid "Service is stopped (timer cannot detect typing)"
msgstr "Служба остановлена (таймер автовозврата не сможет отслеживать печать)"

msgid "Run background service"
msgstr "Работа службы"

msgid "Start or stop the hardware event monitoring daemon"
msgstr "Запуск или остановка фонового процесса чтения клавиатуры"

msgid "Service autostart"
msgstr "Автозапуск при входе в систему"

msgid "Start daemon automatically when logging into Ubuntu"
msgstr "Автоматический старт демона при загрузке пользовательской сессии"

msgid "Restart Service"
msgstr "Перезапустить службу"

msgid "Force restart daemon to re-scan hardware devices"
msgstr "Принудительный перезапуск демона для обновления списка устройств"

msgid "Restart"
msgstr "Перезапустить"

msgid "Security &amp; Privacy"
msgstr "Безопасность и производительность"

msgid "Data Privacy &amp; Zero Logging"
msgstr "Защита данных и приватность"

msgid "SwitchBack DOES NOT record, store, or analyze typed text. The daemon strictly tracks the timestamp of physical keypresses to reset the timer."
msgstr "SwitchBack НЕ сохраняет и НЕ анализирует вводимый текст. Демон фиксирует только сам факт нажатия клавиши для сброса таймера."

msgid "Hardware Mouse Isolation"
msgstr "Аппаратная изоляция мыши"

msgid "Clicks, cursor movement, and mouse wheels (including horizontal wheels) are filtered at the kernel level and do not affect the typing timer."
msgstr "Клики, перемещения курсора и любые колёсики мыши (включая боковые) полностью отфильтрованы на уровне ядра и не влияют на таймер."

msgid "About"
msgstr "О программе"

msgid "SwitchBack Ubuntu Version"
msgstr "Версия SwitchBack Ubuntu"

msgid "For GNOME Shell 45 – 51, Wayland &amp; X11"
msgstr "Для GNOME Shell 45 – 51, Wayland &amp; X11"

msgid "GitHub Repository"
msgstr "Репозиторий GitHub"

msgid "Placement &amp; Dimensions"
msgstr "Расположение и размеры"

msgid "Screen position, length, thickness, shape and color"
msgstr "Кромка экрана, длина, толщина, форма и цвет полосы"

msgid "Visual demonstration of the on-screen countdown indicator"
msgstr "Визуальная демонстрация экранного индикатора"

msgid "Developers &amp; Contributors"
msgstr "Разработчики и контрибьюторы"

