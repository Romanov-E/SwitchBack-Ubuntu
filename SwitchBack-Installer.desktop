[Desktop Entry]
Version=1.0
Type=Application
Name=Install SwitchBack
Name[ru]=Установка SwitchBack
Comment=Graphical installer and manager for SwitchBack Ubuntu
Comment[ru]=Графический установщик и менеджер SwitchBack Ubuntu
