[Desktop Entry]
Version=1.0
Type=Application
Name=Install SwitchBack
Name[ru]=Установка SwitchBack
Comment=Graphical installer and manager for SwitchBack Ubuntu
Comment[ru]=Графический установщик и менеджер SwitchBack Ubuntu
Exec=sh -c "cd \"\$(dirname \"%k\")\" && ./install-gui"
Icon=switchback
Terminal=false
Categories=Settings;DesktopSettings;
StartupNotify=true
StartupWMClass=io.github.romanov_e.switchback.installer
